{#
/**
 * @file
 * Theme override to display a region.
 *
 * Available variables:
 * - content: The content for this region, typically blocks.
 * - attributes: HTML attributes for the region div.
 * - region: The name of the region variable as defined in the theme's
 *   .info.yml file.
 *
 * @ingroup templates
 *
 * @see template_preprocess_region()
 */
#}
{% set classes = [
  'region',
  'region-' ~ region|clean_class,
] %}

{#
  By the way, if you don't put any blocks into the navigation region
  through the GUI, this twig file is never called.
#}
{% if content %}
  <!-- Loaded throught region--navigation.html.twig -->
  <div{{ attributes.addClass(classes) }}>
    <div class="row container">
      <div class="col-sm-6">
        {{ content }}
      </div>
      <div class="col-sm-6">
        {% set lcCurrentURL = url("<current>") %}
        {% if '/search/node' not in lcCurrentURL|render|render %}
          {{ drupal_form('Drupal\\search\\Form\\SearchBlockForm') }}
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}
